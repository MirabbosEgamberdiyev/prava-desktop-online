{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prava Online",
  "version": "1.0.0",
  "identifier": "uz.prava.desktop-online",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prava Online - Haydovchilik imtihoniga tayyorlanish",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://accounts.google.com https://telegram.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https: http:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost ws://localhost:1421 http://localhost:8080 http://164.68.100.190:8080 https://pravaonline.uz https://accounts.google.com https://oauth.telegram.org; frame-src https://accounts.google.com https://oauth.telegram.org https://telegram.org; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Prava Online",
    "copyright": "© 2025 Prava Online",
    "category": "Education",
    "shortDescription": "Haydovchilik imtihoniga tayyorlanish",
    "longDescription": "Prava Online — o'zbekistonlik haydovchilik imtihoniga tayyorlanish uchun eng qulay ilova. Bilet, mavzu va marafon rejimlarida mashq qiling.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Russian", "Turkish"],
        "displayLanguageSelector": false
      },
      "wix": {}
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libxdo3",
          "libssl3",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      }
    }
  }
}
